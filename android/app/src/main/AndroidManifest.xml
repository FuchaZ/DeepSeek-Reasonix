<?xml version="1.0" encoding="utf-8"?>
<!--
  The shell's manifest.

  There is no INTERNET-adjacent permission beyond INTERNET itself: the page and
  the kernel talk over loopback, and reaching a server is the kernel's job over
  a socket it owns. Reading and writing files goes through the system's document
  picker (SAF), which hands back a grant for one file at a time — so no
  storage permission is declared and none is needed.

  `usesCleartextTraffic` is off here, and cleartext is re-enabled in the network
  security config only because the kernel serves its page on `127.0.0.1` and a
  paired computer serves the same page over its LAN address — both plain HTTP.
  The config says what that costs and what bounds it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only to tell the person the kernel is still running while the screen is
         off; it is a foreground service with a dismissible notification, not a
         background wake-up. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- From API 34 every foreground-service *type* needs its own permission as
         well as the general one: naming dataSync in the manifest without asking
         for it is a SecurityException at startForeground, on the one code path
         that keeps a long task alive. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only to take a photo from the composer. Requested when the person picks
         that entry in the attachment menu, never at launch. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The kernel is a child process, and a task left running is one the person
         expects to finish with the screen off. Android's own doze can freeze the
         whole app group instead, which is what the shell asks to be exempt from
         — once, when a turn is actually running, never at launch. It is a
         request the person can refuse, and refusing it only costs battery life
         during a long turn. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Every-file access, for opening a folder on this phone as a workspace.
         The kernel is a plain Go binary: it opens paths with `open(2)`, and a
         document URI is not a path it can open. SAF would hand back exactly
         that unusable URI, so the one honest permission is the broad one —
         granted by the person in system settings, which is the only place
         Android offers it. Nothing here reads storage for any other purpose. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Below API 33 the same folder walk needs the older pair; from 33 they are
         superseded by the permission above and asking for them would be a lie. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- A phone without a touchscreen cannot drive this interface; saying so
         keeps the listing honest rather than letting it install on a TV. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.Reasonix"
        android:usesCleartextTraffic="false"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|smallestScreenSize"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Reasonix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The kernel outlives the screen: a turn that takes minutes would
             otherwise be killed when the phone is pocketed. The service is
             `stopWithTask="false"` so swiping the app away ends it deliberately
             rather than silently, and `foregroundServiceType="dataSync"` is the
             closest honest description of "an agent is working". -->
        <service
            android:name=".KernelService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- The one shelf a camera app may write a capture into, so the photo
             can come back as a URI this app reads without a storage permission. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.captures"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
